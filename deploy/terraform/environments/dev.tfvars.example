# Per-environment overrides for dev. Copy to dev.tfvars (gitignored) and apply:
#   terraform apply -var-file=environments/dev.tfvars
#
# COST-OPTIMIZED DEMO PRESET. Resting cost with these values is ~$0.38/month:
# Artifact Registry + Secret Manager and nothing else. Every Cloud Run service
# scales to zero, and the database is external and auto-suspends.
#
# The project ALREADY EXISTS — this deploys into it, it does not create it.
project_id = "garcia-lorca"
region     = "us-central1"
env        = "dev"

# Both billing accounts belong to the owner; the second one is closed, so dev
# bills to the same account as the sibling project. budget.tf filters by project,
# so the alert below is not polluted by the other project's spend.
# Your billing account, from: gcloud beta billing accounts list
# Deliberately a placeholder: an account identifier does not belong in a tracked
# file, and this repo is handed to the school later. The real value goes in
# dev.tfvars, which is gitignored.
billing_account_id = "000000-000000-000000"

# Image tag. Keep "latest" for a manual bootstrap build; CI overrides it with the
# commit SHA (cloudbuild.yaml substitution _TAG) so infra and revision agree.
image_tag = "latest"

# ---- Database: Cloud SQL, inside this GCP project --------------------------
# Everything stays in GCP. An external Postgres would cost ~$0 instead of
# ~$9.70/mo, but the school's production environment will be 100% GCP, and the
# owner would rather exercise the real connection path (socket, volume mount,
# IAM) here than discover it works on handover day. The demo runs until November
# 2026 and is then torn down and handed to the director's own account, so the
# total exposure is about three months.
#
# Cloud SQL CANNOT scale to zero: this is the one resting cost in the whole
# environment, and it is the entire ~185 MXN/month.
use_cloud_sql = true

# Shared-core tier. db-f1-micro allows roughly 25 connections, which is why
# pkg/dbpool caps each service at 3 open (DB_MAX_OPEN_CONNS below trims it
# further for this tier). If you ever see "remaining connection slots are
# reserved", the fix is one line: db_tier = "db-g1-small" (~$25/mo).
db_tier                           = "db-f1-micro"
db_availability_type              = "ZONAL"
db_point_in_time_recovery_enabled = false
db_backup_retained_count          = 3

# ---- Cloud Run: scale-to-zero everywhere ----------------------------------
# These are now enforced, not merely intended: modules/cloud_run has a
# precondition that FAILS THE APPLY if any service asks for min_instances > 0
# outside prod. To warm the demo before a meeting use scripts/cloud-warm.sh —
# a temporary, reversible gcloud update, not a persisted setting.
gateway_min_instances     = 0
gateway_max_instances     = 1 # the login rate limiter is in-process/per-instance
gateway_cpu_idle          = true
gateway_startup_cpu_boost = false
iam_min_instances         = 0
iam_cpu_idle              = true
iam_startup_cpu_boost     = false

# ---- CORS -----------------------------------------------------------------
# The web app proxies same-origin, so the browser never calls the gateway
# cross-origin and this can stay empty. Fill it in only for native mobile
# clients, AFTER the first apply (deliberately not module.web.uri: that would
# make gateway and web depend on each other and Terraform refuses the cycle).
web_origin = ""

# ---- Budget ---------------------------------------------------------------
# Alerts at 50/80/100% => first email at $7.50, which is already ~20x the
# expected resting cost.
# The currency MUST match the billing account's. This one bills in MXN; asking
# for USD makes the API return a bare "Request contains an invalid argument" that
# never mentions currency. ~280 MXN is about 15 USD, i.e. ~1.5x the expected
# resting cost of ~185 MXN, so the 50% alert lands at ~140 MXN.
monthly_budget_amount = 280
budget_currency       = "MXN"
budget_alert_emails   = ["andres.roqa93@gmail.com"]

# HARD CUTOFF, not just an alert. At 100% of the budget a Cloud Function
# disconnects this project's billing account: every service stops, NOTHING is
# deleted, and re-attaching the account in the console restores it.
#
# Leave this false until you have granted the role it needs, which lives on the
# BILLING ACCOUNT and cannot be granted from Terraform:
#   terraform apply ...                     # creates the SA with the flag false
#   gcloud billing accounts add-iam-policy-binding YOUR-BILLING-ACCOUNT-ID \
#     --member="serviceAccount:$(terraform output -raw billing_killswitch_sa)" \
#     --role="roles/billing.projectManager"
# then flip it to true and apply again.
enable_billing_killswitch = false

# ---- Owner temp password --------------------------------------------------
# Required for a real shared env, or the owner has no way to log in. Inject the
# value out of band at apply time, never here:
#   TF_VAR_owner_temp_password=... terraform apply ...
seed_owner_secret = true

# ---- Scheduled billing run ------------------------------------------------
# OFF for a demo: a job that bills the wrong school cycle is worse than no job.
billing_schedule_enabled = false

# ---- Identity Platform ----------------------------------------------------
# F1 of .claude/docs/PLAN-identity-platform.md. Provisioning ONLY: nothing
# authenticates through it until the gateway is cut over (F6), so turning this
# on cannot affect the login a live demo is using.
#
# Free below 50,000 monthly active users. A school of ~1,500 (pupils, staff and
# guardians) stays inside that by two orders of magnitude.
enable_identity_platform = true

# The WEB api key (Firebase console → project settings, or
# `gcloud services api-keys list`). Only used to MAIL invitation and
# password-reset links; it is the same public key the browser carries.
# Leave empty and sign-in still works — only inviting refuses.
identity_platform_api_key = ""

# Domains allowed to complete OAuth redirects and password-reset action links.
# No scheme, no trailing slash. Passed explicitly rather than derived from the
# web module, so this config does not depend on the Cloud Run deploy.
# The school's own domain (ceglorca.com) is NOT required to migrate: Identity
# Platform sends reset mail from its own sender to whatever address the user
# has. Add it later (F7) only to get a nicer From: line.
identity_platform_authorized_domains = ["localhost", "web-xxxxxxxx-uc.a.run.app"]
