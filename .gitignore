# Generated code — regenerated from proto/ via `buf generate`, never committed.
# EXCEPTION: gen/go's module manifest (go.mod/go.sum) is hand-maintained
# infrastructure, not generated output — track it so CI (and the workspace) can
# build after `buf generate`. Everything else under gen/ stays ignored.
/gen/*
!/gen/go/
/gen/go/*
!/gen/go/go.mod
!/gen/go/go.sum

# Go
*.exe
*.test
*.out
/bin/
vendor/

# Node / TS / Turborepo
node_modules/

# Package manager: pnpm ONLY — npm/yarn lockfiles must never be committed
package-lock.json
yarn.lock

.next/
out/
dist/
.turbo/
*.tsbuildinfo
.expo/
web-build/

# Frontend build hardening: source maps must never be committed or shipped
*.map

# Env / secrets
.env
.env.*
!.env.example
*-key.json
*.pem
service-account*.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# pnpm store written by the dockerized web container (bind mount)
.pnpm-store/
.gstack/

# Playwright run output: traces, videos and screenshots of the last run.
apps/web/test-results/
apps/web/playwright-report/
.superpowers/

# Built in CI by the proto job and handed to the go matrix as an artifact
# (govulncheck, built once instead of `go install`ed in all 14 legs).
dist-tools/

importaciones/