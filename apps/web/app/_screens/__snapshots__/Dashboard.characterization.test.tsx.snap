{
  "button": {
    "animation": "fadeUp .5s cubic-bezier(.22,.61,.36,1) both",
    "animation-delay": "0.15s",
    "background": "color-mix(in oklab, #5C6B61 9%, #FFFFFF)",
    "border": "1.5px solid color-mix(in oklab, #5C6B61 45%, #E7ECE5)",
    "border-radius": "22px",
    "box-shadow": "0 4px 10px rgba(16,40,24,.07), 0 18px 40px rgba(16,40,24,.10)",
    "box-sizing": "border-box",
    "cursor": "pointer",
    "display": "flex",
    "flex-direction": "column",
    "font-family": "<unset>, system-ui, sans-serif",
    "gap": "16px",
    "min-height": "172px",
    "padding": "22px 22px 20px",
    "position": "relative",
    "text-align": "left",
    "transform": "translateY(-4px)",
    "transition": "all .22s cubic-bezier(.22,.61,.36,1)",
  },
  "button>div[0]": {
    "align-items": "flex-start",
    "box-sizing": "border-box",
    "display": "flex",
    "justify-content": "space-between",
  },
  "button>div[0]>div[0]": {
    "background": "#F1F4EF",
    "border-radius": "18px",
    "box-shadow": "none",
    "box-sizing": "border-box",
    "color": "#5C6B61",
    "display": "grid",
    "flex-shrink": "0",
    "height": "58px",
    "place-items": "center",
    "transform": "scale(1.06) rotate(-3deg)",
    "transition": "transform .25s cubic-bezier(.22,.61,.36,1)",
    "width": "58px",
  },
  "button>div[0]>div[0]>svg[0]": {
    "box-sizing": "border-box",
  },
  "button>div[1]": {
    "box-sizing": "border-box",
    "margin-top": "auto",
  },
  "button>div[1]>div[0]": {
    "box-sizing": "border-box",
    "color": "#0C2417",
    "font-family": "<unset>, system-ui, sans-serif",
    "font-size": "18.5px",
    "font-weight": "700",
    "letter-spacing": "-.02em",
  },
  "button>div[1]>div[1]": {
    "box-sizing": "border-box",
    "color": "#5C6B61",
    "font-size": "13.5px",
    "margin-top": "3px",
  },
  "button>span[2]": {
    "bottom": "18px",
    "box-sizing": "border-box",
    "color": "#5C6B61",
    "opacity": "1",
    "position": "absolute",
    "right": "18px",
    "transform": "translateX(0)",
    "transition": "all .22s cubic-bezier(.22,.61,.36,1)",
  },
  "button>span[2]>svg[0]": {
    "box-sizing": "border-box",
  },
}
`;

