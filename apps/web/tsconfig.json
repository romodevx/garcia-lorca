{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@garcia-lorca/ui": ["../../packages/ui/index.ts"],
      "@garcia-lorca/ui/flags": ["../../packages/ui/src/flags/index.ts"],
      "@garcia-lorca/domain": ["../../packages/domain/index.ts"],
      "@garcia-lorca/api-client": ["../../packages/api-client/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
