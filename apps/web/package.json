    "e2e:announcements-view": "playwright test --project=announcements-view"
  },
  "dependencies": {
    "@garcia-lorca/api-client": "workspace:*",
    "@garcia-lorca/domain": "workspace:*",
    "@garcia-lorca/i18n": "workspace:*",
    "@garcia-lorca/ui": "workspace:*",
    "@tanstack/react-query": "5.101.0",
    "firebase": "12.18.0",
    "next": "16.2.9",
    "next-intl": "4.13.0",
    "qr-scanner": "1.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@garcia-lorca/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.9",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
