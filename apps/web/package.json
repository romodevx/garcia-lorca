{
  "name": "@garcia-lorca/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:no-sourcemaps": "node scripts/check-no-sourcemaps.mjs .next/static",
    "e2e": "playwright test --project=chromium --project=mobile --project=responsive",
