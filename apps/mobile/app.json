{
  "expo": {
    "name": "García Lorca",
    "slug": "garcia-lorca",
    "scheme": "garcialorca",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "García Lorca abre tus fotos para que elijas la captura o la foto del comprobante de pago que envías a la escuela.",
          "cameraPermission": "García Lorca usa la cámara para que tomes una foto del comprobante de pago que envías a la escuela.",
          "microphonePermission": false
        }
      ],
      "./plugins/withSceneDelegate.ts",
      "./plugins/withPodsDeploymentTarget.ts"
    ],
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes"
    },
    "android": {
      "jsEngine": "hermes"
    },
    "updates": {
      "enabled": true
    }
  }
}
