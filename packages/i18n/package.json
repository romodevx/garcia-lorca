{
  "name": "@garcia-lorca/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ICU MessageFormat catalogs, type-safe keys, parity validator & framework-agnostic formatter. Consumed by apps/web (next-intl) and apps/mobile (react-i18next). Imports NO UI framework.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./messages/*": "./src/messages/*"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "2.11.2",
    "intl-messageformat": "10.7.16"
  },
  "devDependencies": {
    "@garcia-lorca/config": "workspace:*",
    "eslint": "10.4.1",
    "vitest": "4.1.8"
  }
}
