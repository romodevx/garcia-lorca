# Local Docker stack — dev-only credentials. Copy to .env (gitignored) and edit.
# These are LOCAL ONLY; shared environments use the secret manager (see
# deploy/terraform/secrets.tf), never these values.
#
#   cp .env.example .env   (or just `make run`, which creates it for you)

# Host ports. Change these if another local process already owns the default
# (another Postgres on 5432, another dev server on 3000). Internal traffic is
# unaffected — it always uses the in-network service names.
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=3000

# Postgres superuser password (container bootstrap).
POSTGRES_PASSWORD=change-me-postgres

# Application login role password (the `app` role used by every service).
APP_DB_PASSWORD=change-me-app

# Owner/director temporary password (local seed only; you change it at first login).
# Shared envs source this from Secret Manager, never this file: set
# seed_owner_secret=true and inject var.owner_temp_password out of band
# (deploy/terraform/secrets.tf; see deploy/README.md "Owner temporary password").
OWNER_TEMP_PASSWORD=change-me-owner
