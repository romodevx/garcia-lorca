{
  "name": "garcia-lorca",
  "private": true,
  "version": "0.0.0",
  "description": "García Lorca — Sistema de Gestión Escolar (frontend monorepo)",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "demo:reset": "sh scripts/reset-demo-db.sh",
    "demo:verify": "pnpm --filter @garcia-lorca/web e2e",
    "demo:seed": "sh scripts/reset-demo-db.sh && node scripts/seed-demo.mjs",
    "demo:smoke": "E2E_SKIP_RESET=1 pnpm --filter @garcia-lorca/web e2e:demo",
    "demo:ready": "pnpm demo:verify && pnpm demo:seed && pnpm demo:smoke"
  },
  "devDependencies": {
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
